.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
shelved/
scratch/
checkpoints/
plots/
benchmarks/
*.json
*.csv
*.log
*.aux
*.out
*.toc
notebooks/*
!notebooks/kaggle_training.ipynb
# The notebook exceptions below were commented out on 2026-08-22: those notebooks
# belong to the retired v1 generation and no longer need tracking.  kaggle_training
# stays tracked.  Re-enable by uncommenting.
# !notebooks/kaggle_comparative_benchmark.ipynb
# !notebooks/kaggle_vanilla_baseline.ipynb
# !notebooks/kaggle_two_stage_ippo.ipynb
# !notebooks/kaggle_agent_estimator_matrix.ipynb
# !notebooks/run_analysis_*.ipynb
# !notebooks/comparative_run_analysis_suite.ipynb
# !notebooks/overnight_analysis_2026-08-14.ipynb
# Experiment results are DATA, not build artefacts: the blanket *.json rule above would
# silently drop every raw result, which is exactly what the reproducibility requirement
# needs kept. Exempt them explicitly.
!results/**/*.json
!results/*.json

# Offline WandB runs: large, machine-generated, and re-syncable from the cluster.
# The JSON files under results/ are the record; these are only a second view.
wandb/
wandb_cluster/

# Extracted from myriad_rescue_20260820.tar.gz; the tarball is the artefact.
results/myriad_rescue/marl_sa_fast/

# Untracked scratch that accumulated at the repo root
logs/
# ...but docs/logs/ is the experiment record, not run output. The rule above was
# silently swallowing every NEW file there, which directly undercuts the standing
# practice of logging measurements as they happen. Existing files were tracked, so
# this only ever bit on the first write of a new log.
!docs/logs/
!docs/logs/**
wandb/
wandb_cluster/
