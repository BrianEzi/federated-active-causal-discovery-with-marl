.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
shelved/
scratch/
checkpoints/
plots/
benchmarks/
*.json
*.csv
*.log
*.aux
*.out
*.toc
notebooks/*
!notebooks/kaggle_training.ipynb
# The notebook exceptions below were commented out on 2026-08-22: those notebooks
# belong to the retired v1 generation and no longer need tracking.  kaggle_training
# stays tracked.  Re-enable by uncommenting.
# !notebooks/kaggle_comparative_benchmark.ipynb
# !notebooks/kaggle_vanilla_baseline.ipynb
# !notebooks/kaggle_two_stage_ippo.ipynb
# !notebooks/kaggle_agent_estimator_matrix.ipynb
# !notebooks/run_analysis_*.ipynb
# !notebooks/comparative_run_analysis_suite.ipynb
# !notebooks/overnight_analysis_2026-08-14.ipynb
# Experiment results are DATA, not build artefacts: the blanket *.json rule above would
# silently drop every raw result, which is exactly what the reproducibility requirement
# needs kept. Exempt them explicitly.
!results/**/*.json
!results/*.json

# Offline WandB runs: large, machine-generated, and re-syncable from the cluster.
# The JSON files under results/ are the record; these are only a second view.
wandb/
wandb_cluster/

# Extracted from myriad_rescue_20260820.tar.gz; the tarball is the artefact.
results/myriad_rescue/marl_sa_fast/

# Untracked scratch that accumulated at the repo root
logs/
# ...but docs/logs/ is the experiment record, not run output. The rule above was
# silently swallowing every NEW file there, which directly undercuts the standing
# practice of logging measurements as they happen. Existing files were tracked, so
# this only ever bit on the first write of a new log.
!docs/logs/
!docs/logs/**
wandb/
wandb_cluster/

# ---------------------------------------------------------------------------------------
# Deliberately local, 2026-08-22
# ---------------------------------------------------------------------------------------
#
# thesis/   The dissertation LaTeX. Already versioned by Overleaf, and a second copy in git
#           is a second place for it to diverge. Overleaf is the single source of truth.
#
# textbook/ Background reading written for the author's own understanding. Nothing in the
#           codebase depends on it and no reported number comes from it.
#           NOTE: textbook/verification/*.py WAS tracked until today and is preserved in
#           history -- recover with `git show af2b4b2:textbook/verification/v1_graph_space.py`.
#
# temp.py   Root-level scratch.
thesis/
textbook/
temp.py

# The v1 analysis notebooks were untracked on 2026-08-22: rendered charts and embedded
# outputs, 5.2 MB of the repository, none of it a source for any reported number. The five
# kaggle_* run notebooks stay tracked -- those are how jobs were actually launched.
# All of them remain in history: `git show af2b4b2:legacy/notebooks/sa_findings.ipynb`.
legacy/notebooks/run_analysis_*.ipynb
legacy/notebooks/comparative_run_analysis_suite.ipynb
legacy/notebooks/overnight_analysis_*.ipynb
legacy/notebooks/sa_findings.ipynb

# In-progress fleet checkpoints churn every few minutes while a run is training and are
# rebuildable; only _best.pt (what evaluation loads) and the result .json are worth keeping.
results/power/rho/*_u[0-9]*.pt
results/power/rho/*_resume_*.pt
